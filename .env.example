# La base de producción (el Postgres del VPS).
DATABASE_URL=
# La base de desarrollo, la que se usa con ENVIRONMENT=development.
DATABASE_URL_DEV=
# `production` (default si queda vacía) o `development`. Decide contra qué base se conectan la
# app y `pnpm db:migrate`. En development sin DATABASE_URL_DEV falla: nunca cae en la real.
ENVIRONMENT=
# Firma las sesiones (openssl rand -base64 32).
AUTH_SECRET=
# `true` habilita /registro para crear cuentas. Dejalo vacío el resto del tiempo.
SIGNUP_ENABLED=
# El "API Read Access Token" de TMDB (themoviedb.org → Settings → API). Sin él, no hay búsqueda
# ni tapas: todo se carga a mano con la tapa genérica.
TMDB_API_TOKEN=
# Idioma de títulos y sinopsis de TMDB. Default: es-MX.
TMDB_LANGUAGE=
